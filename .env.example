# Copiez ce fichier en .env puis renseignez les valeurs (le fichier .env n'est jamais versionné).

# --- Obligatoire ----------------------------------------------------------------------------
POSTGRES_PASSWORD=change-me
# 32 caractères aléatoires minimum, ex. : openssl rand -base64 48
JWT_SECRET=change-me-with-at-least-32-random-characters
# Clé API Flickr (https://www.flickr.com/services/apps/create/). Inutile avec PHOTO_PROVIDER=fixtures.
FLICKR_API_KEY=

# --- Jeu ------------------------------------------------------------------------------------
# flickr (vraies photos) ou fixtures (photos de démonstration, hors ligne)
PHOTO_PROVIDER=flickr
# non-commercial (toutes les licences ouvertes) ou commercial (exclut les licences NC)
LICENSE_PROFILE=non-commercial
# Liste explicite de licences autorisées (prioritaire sur LICENSE_PROFILE), ex. CC-BY-4.0,CC0-1.0
# ALLOWED_LICENSES=
GAME_TIMEZONE=Europe/Paris
# Défis de démonstration (uniquement avec PHOTO_PROVIDER=fixtures)
SEED_DEMO=false

# Compte administrateur créé au premier démarrage
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=change-me-admin-password

# Barème (§5.2, indicatif : à équilibrer après les premiers tests)
# SCORE_NO_HINT_BONUS=50
# SCORE_SPEED_BONUS=25
# SCORE_SPEED_THRESHOLD_SECONDS=30
# SCORE_DAILY_BONUS=50
# STREAK_BONUS_EVERY_DAYS=7
# STREAK_BONUS_XP=200

# --- Exposition -----------------------------------------------------------------------------
HTTP_PORT=8080
PUBLIC_URL=http://localhost:8080
# Production HTTPS (docker-compose.prod.yml)
# DOMAIN=jeu.example.org
# ACME_EMAIL=ops@example.org
